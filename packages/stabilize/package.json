{
  "name": "@snapseq/stabilize",
  "version": "0.0.0",
  "description": "snapseq plugin: freezes viewport units so snapPage works on 100vh pages, and stops motion before each shot.",
  "license": "ISC",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapseq/snapseq.git",
    "directory": "packages/stabilize"
  },
  "homepage": "https://github.com/snapseq/snapseq/tree/main/packages/stabilize#readme",
  "bugs": {
    "url": "https://github.com/snapseq/snapseq/issues"
  },
  "keywords": [
    "snapseq",
    "playwright",
    "screenshot",
    "full-page",
    "viewport",
    "vh"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "snapseq": ">=0.3.0 <1.0.0-0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
    "sharp": "0.35.5",
    "snapseq": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
