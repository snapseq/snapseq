{
  "name": "snapseq",
  "version": "0.6.0",
  "description": "Scripted screenshot sequences on Playwright Test, and orchestration files that run them.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapseq/snapseq.git",
    "directory": "packages/snapseq"
  },
  "homepage": "https://github.com/snapseq/snapseq#readme",
  "bugs": {
    "url": "https://github.com/snapseq/snapseq/issues"
  },
  "keywords": [
    "playwright",
    "screenshot",
    "screenshots",
    "sequence",
    "orchestration",
    "full-page",
    "visual",
    "fixtures",
    "testing"
  ],
  "engines": {
    "node": "^20.17.0 || >=22.5.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "snapseq": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.59 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
    "sharp": "0.35.5",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "jiti": "2.7.0"
  }
}
