{
  "name": "snapseq",
  "version": "0.2.0",
  "description": "Playwright Test fixtures for scripted screenshot captures.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syantra/snapseq.git"
  },
  "homepage": "https://github.com/syantra/snapseq#readme",
  "bugs": {
    "url": "https://github.com/syantra/snapseq/issues"
  },
  "keywords": [
    "playwright",
    "screenshot",
    "screenshots",
    "capture",
    "full-page",
    "visual",
    "fixtures",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "snapseq": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.59 <2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.20.0"
}
